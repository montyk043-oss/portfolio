<script>
/* =====================================================
   You don't need to edit anything below this line.
   ===================================================== */

const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- 1. Fade-in on scroll ---------- */
const revealObserver = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("show");
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll(".reveal").forEach(el => revealObserver.observe(el));

/* ---------- 2. Parallax ----------
   data-speed="0.1"    moves up/down
   data-speed-x="0.1"  moves left/right
   Bigger number = stronger effect. Negative = opposite direction. */
if (!reducedMotion) {
  const movers = document.querySelectorAll("[data-speed], [data-speed-x]");
  let waiting = false;

  function updateParallax() {
    const strength = window.innerWidth < 700 ? 0.4 : 1; // gentler on phones
    movers.forEach(el => {
      const box = el.parentElement.getBoundingClientRect();
      if (box.bottom < -200 || box.top > window.innerHeight + 200) return;
      const distance = box.top + box.height / 2 - window.innerHeight / 2;
      const y = -distance * (parseFloat(el.dataset.speed) || 0) * strength;
      const x = -distance * (parseFloat(el.dataset.speedX) || 0) * strength;
      el.style.transform = `translate(${x}px, ${y}px)`;
    });
    waiting = false;
  }

  window.addEventListener("scroll", () => {
    if (!waiting) { waiting = true; requestAnimationFrame(updateParallax); }
  }, { passive: true });
  window.addEventListener("resize", updateParallax);
  updateParallax();
}

/* ---------- 3. Video slider ---------- */
const track = document.getElementById("track");
const slides = [...track.querySelectorAll(".slide")];
const counter = document.getElementById("counter");
const progress = document.getElementById("progress");

function sidePadding() {
  return parseFloat(getComputedStyle(track).paddingLeft);
}

function updateSlider() {
  const maxScroll = track.scrollWidth - track.clientWidth;
  progress.style.width = (maxScroll > 0 ? track.scrollLeft / maxScroll * 100 : 100) + "%";

  let current = 0;
  slides.forEach((slide, i) => {
    if (slide.offsetLeft - sidePadding() <= track.scrollLeft + 4) current = i;
  });
  if (track.scrollLeft >= maxScroll - 2) current = slides.length - 1;

  const pad = n => String(n).padStart(2, "0");
  counter.textContent = pad(current + 1) + " / " + pad(slides.length);
}

function moveSlider(direction) {
  const pos = track.scrollLeft;
  const pad = sidePadding();
  let target;
  if (direction > 0) {
    target = slides.find(s => s.offsetLeft - pad > pos + 4);
  } else {
    target = [...slides].reverse().find(s => s.offsetLeft - pad < pos - 4);
  }
  const left = target ? target.offsetLeft - pad : (direction > 0 ? track.scrollWidth : 0);
  track.scrollTo({ left, behavior: reducedMotion ? "auto" : "smooth" });
}

document.getElementById("next").addEventListener("click", () => moveSlider(1));
document.getElementById("prev").addEventListener("click", () => moveSlider(-1));
track.addEventListener("scroll", updateSlider, { passive: true });
window.addEventListener("resize", updateSlider);
track.addEventListener("keydown", e => {
  if (e.key === "ArrowRight") { e.preventDefault(); moveSlider(1); }
  if (e.key === "ArrowLeft")  { e.preventDefault(); moveSlider(-1); }
});

/* Mouse dragging (touch and trackpad scroll work automatically) */
let dragStart = null;
let wasDragged = false;

track.addEventListener("pointerdown", e => {
  if (e.pointerType !== "mouse") return;
  dragStart = { x: e.clientX, scroll: track.scrollLeft };
  wasDragged = false;
});
window.addEventListener("pointermove", e => {
  if (!dragStart) return;
  const moved = e.clientX - dragStart.x;
  if (Math.abs(moved) > 5) { wasDragged = true; track.classList.add("dragging"); }
  track.scrollLeft = dragStart.scroll - moved;
});
window.addEventListener("pointerup", () => {
  dragStart = null;
  track.classList.remove("dragging");
});
track.addEventListener("dragstart", e => e.preventDefault());

/* Open a video when a slide is clicked (but not after a drag) */
slides.forEach(slide => {
  slide.addEventListener("click", e => {
    if (wasDragged) { e.preventDefault(); wasDragged = false; return; }
    openVideo(slide);
  });
});

updateSlider();

/* ---------- 4. Popup ---------- */
const popup = document.getElementById("popup");
const popupMedia = document.getElementById("popup-media");
const popupTitle = document.getElementById("popup-title");
const popupDesc = document.getElementById("popup-desc");
const closeButton = document.getElementById("popup-close");
let openedFrom = null;

function openPopup(title, desc, opener) {
  openedFrom = opener;
  popupTitle.textContent = title || "";
  popupDesc.textContent = desc || "";
  popup.hidden = false;
  document.body.style.overflow = "hidden";
  closeButton.focus();
}

function closePopup() {
  const video = popupMedia.querySelector("video");
  if (video) video.pause();
  popupMedia.innerHTML = "";           // also stops embedded videos
  popup.hidden = true;
  document.body.style.overflow = "";
  if (openedFrom) openedFrom.focus();
}

function openVideo(slide) {
  const file = slide.dataset.src;
  const embed = slide.dataset.embed;

  if (file) {
    // Built-in controls give play/pause, mute, and fullscreen
    popupMedia.innerHTML = `<video controls autoplay playsinline src="${file}"></video>`;
  } else if (embed) {
    popupMedia.innerHTML = `<iframe src="${embed}" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
  } else {
    popupMedia.innerHTML = `<p class="notice">No video added yet. Put an MP4 path in data-src or an embed link in data-embed for this slide.</p>`;
  }
  openPopup(slide.dataset.title, slide.dataset.desc, slide);
}

/* Projects open their image large */
document.querySelectorAll(".project").forEach(project => {
  project.addEventListener("click", () => {
    const picture = project.querySelector("img, .ph").cloneNode(true);
    popupMedia.innerHTML = "";
    popupMedia.appendChild(picture);
    openPopup(project.dataset.title, project.dataset.desc, project);
  });
});

closeButton.addEventListener("click", closePopup);
popup.addEventListener("click", e => {
  if (e.target === popup || e.target === popupMedia) closePopup();
});
document.addEventListener("keydown", e => {
  if (e.key === "Escape" && !popup.hidden) closePopup();
});

/* Pause video if the user switches tabs */
document.addEventListener("visibilitychange", () => {
  const video = popupMedia.querySelector("video");
  if (document.hidden && video) video.pause();
});
</script>
</body>
</html>
