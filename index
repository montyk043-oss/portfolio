<style>
/* =====================================================
   SETTINGS — change colors and spacing here
   ===================================================== */
:root {
  --black: #0b0b0b;
  --white: #ffffff;
  --text: #111111;
  --grey: #7a7a7a;
  --violet: #7b5cff;            /* divider lines and accents */
  --pad: clamp(20px, 5vw, 80px); /* side margins */
}

/* ---------- Basics ---------- */
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: "Poppins", sans-serif;
  font-weight: 300;
  color: var(--text);
  background: var(--white);
  overflow-x: hidden;
}
img { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); }
a { color: inherit; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
:focus-visible { outline: 1px solid var(--violet); outline-offset: 4px; }

/* ---------- Shared styles ---------- */
.section {
  position: relative;
  padding: clamp(90px, 12vw, 170px) var(--pad);
  border-top: 1px solid var(--violet);
}
.dark { background: var(--black); color: var(--white); }
.num {
  position: absolute; top: 28px; right: var(--pad);
  font-size: 12px; letter-spacing: 0.14em; font-weight: 400;
}
.label { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--grey); }
.h-xl {
  font-size: clamp(44px, 9vw, 140px); font-weight: 200;
  text-transform: uppercase; line-height: 0.9; letter-spacing: -0.03em;
}
.h-lg {
  font-size: clamp(36px, 6vw, 96px); font-weight: 200;
  text-transform: uppercase; line-height: 0.95; letter-spacing: -0.02em;
}
.italic { font-style: italic; font-weight: 200; text-transform: none; }
.body { font-size: 15px; line-height: 1.8; max-width: 36ch; }
.caption { margin-top: 12px; font-size: 12px; line-height: 1.5; }
.caption b {
  display: block; font-weight: 500; font-size: 11px;
  letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 2px;
}

/* Grey placeholder box — replace with <img> */
.ph {
  width: 100%; height: 100%; background: #cfcfcf; color: #555;
  display: flex; align-items: flex-end; padding: 12px;
  font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
}
.dark .ph { background: #2a2a2a; color: #999; }

.frame { position: relative; overflow: hidden; }
.tilt-left { rotate: -3deg; }
.tilt-right { rotate: 3deg; }
.outline { outline: 1px solid var(--violet); outline-offset: 10px; }

/* Fade-up when scrolled into view */
.reveal { opacity: 0; transform: translateY(28px); transition: opacity 1s ease, transform 1s ease; }
.reveal.show { opacity: 1; transform: none; }

/* ---------- Navigation ---------- */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  display: flex; justify-content: space-between;
  padding: 20px var(--pad);
  mix-blend-mode: difference; color: #fff;
  font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 400;
}
.nav ul { display: flex; gap: 24px; list-style: none; }
.nav a { text-decoration: none; }
.nav a:hover { text-decoration: underline; text-underline-offset: 4px; }

/* ---------- 01 Hero ---------- */
.hero {
  min-height: 100vh; display: grid; place-items: center;
  text-align: center; overflow: hidden; border-top: 0;
}
.hero-portrait {
  position: absolute; top: 12%; left: 50%;
  width: clamp(200px, 26vw, 380px); aspect-ratio: 3 / 4;
  margin-left: calc(clamp(200px, 26vw, 380px) / -2);
}
.hero-title {
  position: relative; z-index: 2; margin-top: 28vh;
  font-size: clamp(60px, 16vw, 260px); font-weight: 200;
  letter-spacing: -0.05em; line-height: 0.8;
  text-transform: uppercase; mix-blend-mode: difference;
}
.hero-sub {
  position: relative; z-index: 2; margin-top: 24px;
  font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 400;
}
.intro { animation: intro 1.6s ease both; }
@keyframes intro { from { opacity: 0; translate: 0 40px; } to { opacity: 1; translate: 0 0; } }

/* ---------- 02 About ---------- */
.about { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--pad); min-height: 90vh; }
.about .body { margin-top: 48px; }
.about-imgs { position: relative; min-height: 560px; }
.about-1 { position: absolute; right: 0; top: 0; width: 58%; aspect-ratio: 3 / 4; }
.about-2 { position: absolute; left: 0; bottom: 0; width: 44%; aspect-ratio: 4 / 5; }

/* ---------- 03 Experience ---------- */
.experience { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--pad); }
.exp-img { width: min(300px, 60%); aspect-ratio: 4 / 5; margin-top: 60px; }
.exp-list { list-style: none; }
.exp-list li {
  display: grid; grid-template-columns: 1.2fr 1fr 0.7fr; gap: 20px;
  padding: 26px 0; border-top: 1px solid #e3e3e3; font-size: 13px;
}
.exp-list li:last-child { border-bottom: 1px solid #e3e3e3; }
.exp-list h3 { font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }
.exp-list p { grid-column: 1 / -1; color: #555; line-height: 1.7; max-width: 60ch; }

/* ---------- 04 Skills ---------- */
.skills { display: grid; grid-template-columns: 1fr 1.3fr; gap: var(--pad); align-items: start; }
.skills-img { aspect-ratio: 3 / 4; margin-top: 48px; }
.skill-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 40px; margin-top: 64px; }
.skill-grid h3 {
  font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
  padding-bottom: 10px; margin-bottom: 14px; border-bottom: 1px solid var(--violet);
}
.skill-grid ul { list-style: none; font-size: 14px; line-height: 2; }

/* ---------- 05 My work ---------- */
.work-grid {
  display: grid; grid-template-columns: repeat(12, 1fr);
  gap: 64px 28px; margin-top: 80px;
}
.project { text-align: left; display: block; }
.project .frame { transition: scale 0.8s ease; }
.project:hover .frame { scale: 0.98; }
.project:hover img { filter: grayscale(0.5); }
.wide { grid-column: span 7; }  .wide .frame { aspect-ratio: 16 / 10; }
.tall { grid-column: span 5; }  .tall .frame { aspect-ratio: 4 / 5; }
.half { grid-column: span 6; }  .half .frame { aspect-ratio: 1; }
.small { grid-column: span 4; } .small .frame { aspect-ratio: 3 / 4; }
.push-down { margin-top: 120px; }

/* ---------- 06 Typography ---------- */
.type-section { overflow: hidden; min-height: 110vh; display: flex; flex-direction: column; justify-content: center; }
.type-line {
  position: relative; z-index: 2;
  font-size: clamp(48px, 12vw, 210px); font-weight: 200;
  text-transform: uppercase; line-height: 0.95; letter-spacing: -0.05em; white-space: nowrap;
}
.type-line.right { text-align: right; }
.type-line .boxed {
  display: inline-block; border: 1px solid var(--violet);
  padding: 0 0.12em; font-style: italic; text-transform: none;
}
.type-photo { position: absolute; z-index: 1; }
.type-photo.one { top: 8%; right: 14%; width: clamp(140px, 16vw, 240px); aspect-ratio: 3 / 4; }
.type-photo.two { bottom: 8%; left: 10%; width: clamp(120px, 13vw, 200px); aspect-ratio: 4 / 5; }

/* ---------- 07 Video slider ---------- */
.video-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
.slider-controls { display: flex; align-items: center; gap: 20px; font-size: 12px; letter-spacing: 0.14em; }
.arrow {
  width: 48px; height: 48px; border: 1px solid #444;
  display: grid; place-items: center; font-size: 18px; transition: border-color 0.3s;
}
.arrow:hover { border-color: var(--violet); }
.track {
  display: flex; gap: 28px; overflow-x: auto; scrollbar-width: none;
  margin: 64px calc(var(--pad) * -1) 0; padding: 0 var(--pad);
  cursor: grab; user-select: none;
}
.track::-webkit-scrollbar { display: none; }
.track::after { content: ""; flex: 0 0 1px; }
.track.dragging { cursor: grabbing; }
.slide { flex: 0 0 auto; height: clamp(240px, 44vh, 440px); display: flex; flex-direction: column; text-align: left; }
.slide .frame { height: 100%; border: 1px solid #2a2a2a; transition: border-color 0.4s; }
.slide:hover .frame, .slide:focus-visible .frame { border-color: var(--violet); }
.slide .caption { color: #bbb; }
.play-icon {
  position: absolute; inset: 0; display: grid; place-items: center;
  opacity: 0; transition: opacity 0.4s;
}
.play-icon span {
  width: 64px; height: 64px; border: 1px solid #fff; border-radius: 50%;
  display: grid; place-items: center; font-size: 11px; letter-spacing: 0.1em;
}
.slide:hover .play-icon, .slide:focus-visible .play-icon { opacity: 1; }
.progress { height: 1px; background: #333; margin-top: 40px; position: relative; }
.progress-bar { position: absolute; left: 0; top: 0; height: 1px; width: 0; background: var(--violet); }

/* ---------- 08 Other works ---------- */
.others { display: grid; grid-template-columns: repeat(12, 1fr); gap: 40px 28px; margin-top: 80px; }
.o1 { grid-column: 1 / 6; }  .o1 .frame { aspect-ratio: 4 / 5; }
.o2 { grid-column: 7 / 12; margin-top: 160px; } .o2 .frame { aspect-ratio: 16 / 11; }
.o3 { grid-column: 2 / 5; }  .o3 .frame { aspect-ratio: 1; }
.o4 { grid-column: 6 / 9; margin-top: -80px; } .o4 .frame { aspect-ratio: 3 / 4; }
.o5 { grid-column: 9 / 13; margin-top: 60px; } .o5 .frame { aspect-ratio: 4 / 3; }

/* ---------- 09 Contact ---------- */
.contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--pad); align-items: center; min-height: 90vh; }
.contact-list { margin-top: 56px; display: grid; gap: 18px; font-size: 15px; }
.contact-list .label { display: inline-block; width: 110px; }
.contact-list a { text-decoration: none; border-bottom: 1px solid #444; padding-bottom: 2px; }
.contact-list a:hover { border-color: var(--violet); }
.contact-portrait { width: min(380px, 100%); aspect-ratio: 3 / 4; justify-self: end; }
.footer {
  display: flex; justify-content: space-between; padding: 28px var(--pad);
  background: var(--black); color: #777; border-top: 1px solid var(--violet);
  font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
}

/* ---------- Popup (video and image viewer) ---------- */
.popup {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(5, 5, 5, 0.96); color: #fff;
  display: flex; flex-direction: column; padding: 24px var(--pad);
}
.popup[hidden] { display: none; }
.popup-media { flex: 1; display: grid; place-items: center; min-height: 0; }
.popup-media img { width: auto; max-width: 100%; max-height: 78vh; filter: none; }
.popup-media video, .popup-media iframe {
  width: min(1200px, 100%); max-height: 78vh; aspect-ratio: 16 / 9; border: 0; background: #000;
}
.popup-media .ph { width: min(900px, 90vw); height: 60vh; }
.popup-info { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; padding-top: 20px; }
.popup-title { font-size: 18px; }
.popup-desc { font-size: 13px; color: #aaa; margin-top: 4px; max-width: 60ch; }
.popup-close { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
.popup-close:hover { color: var(--violet); }
.notice { font-size: 13px; color: #aaa; text-align: center; max-width: 44ch; line-height: 1.7; }

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  .nav ul { display: none; }
  .about, .experience, .skills, .contact { grid-template-columns: 1fr; }
  .about-imgs { min-height: 440px; }
  .exp-list li { grid-template-columns: 1fr 1fr; }
  .wide, .tall, .half, .small { grid-column: span 12; }
  .push-down { margin-top: 0; }
  .others > * { grid-column: span 12 !important; margin-top: 0 !important; }
  .contact-portrait { justify-self: start; width: min(300px, 80%); }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .skill-grid, .exp-list li { grid-template-columns: 1fr; }
  .type-line { white-space: normal; }
}

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .intro { animation: none; }
}
</style>
</head>
